import (
  "github.com/falcon-autotuning/std-lib@v1.2.2/falconCore/communications/messages/voltageStatesResponse"
  "github.com/falcon-autotuning/std-lib@v1.2.2/falconCore/communications/messages/measurementRequest"
  "github.com/falcon-autotuning/std-lib@v1.2.2/falconCore/communications/messages/measurementResponse"
  "github.com/falcon-autotuning/std-lib@v1.2.2/falconCore/communications/messages/settingResponse"
  "github.com/falcon-autotuning/std-lib@v1.2.2/falconCore/physics/config"
  "github.com/falcon-autotuning/std-lib@v1.2.2/falconCore/instrumentInterfaces/names/ports"
)

ffimport "mock-hub-wrapper.cpp" ("-I/opt/falcon/include/") ("-L/opt/falcon/lib" "-lfalcon-comms" "-lnats")

struct MockHub {
    routine New () -> (MockHub hub)
    routine Start (int port) -> (bool success)
    routine Stop () -> ()
    routine SetDeviceState (voltageStatesResponse::VoltageStatesResponse response) -> ()
    routine SetConfig (config::Config config) -> ()
    routine SetPortPayload (ports::Ports knobs, ports::Ports meters) -> ()
    routine SetMeasurementResponse (measurementResponse::MeasurementResponse response) -> ()
    routine SetSettingResponse (settingResponse::SettingResponse response) -> ()
    routine SampleMeasurementResponseJSON () -> (string json)
    routine SampleMeasurementResponse () -> (measurementResponse::MeasurementResponse response)
    routine SampleMeasurementRequestJSON () -> (string json)
    routine SampleMeasurementRequest () -> (measurementRequest::MeasurementRequest request)
}
